[package]
name    = "{{project.name}}"
version = "0.1.0"

[targets.{{project.name}}]
kind = "bin"
main = "src/main.cpp"

# `codegen` hands this project protoc, built for this machine from the same
# protobuf release it links, and the `protogen` rule build.mcpp imports.
[dependencies]
{{self.name}} = { version = "{{self.version}}", features = ["codegen"] }
